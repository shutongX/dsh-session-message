{
  "name": "dsh-session-message",
  "version": "0.1.0",
  "private": false,
  "description": "Cross-session messaging for DeepSeek Harness: list sessions in every workspace and send a user-role message into another live or cold session.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/core.test.mjs test/plugin.test.mjs"
  },
  "author": "shutongX",
  "homepage": "https://github.com/shutongX/dsh-session-message#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shutongX/dsh-session-message.git"
  },
  "bugs": {
    "url": "https://github.com/shutongX/dsh-session-message/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "messaging",
    "multi-agent",
    "cordis"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <3"
  },
  "icon": "./icon.svg"
}
